# Database (локальная разработка)
DATABASE_URL="postgresql://crmka:crmka_secret@localhost:5432/crmka?schema=public"

# NextAuth — в production обязательно ≥32 символов (иначе модуль падает на старте).
# Генерация: `openssl rand -hex 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-random-string"

# Опционально — отдельные секреты для admin-сессии и клиентского портала.
# Если не заданы — используется NEXTAUTH_SECRET.
# ADMIN_JWT_SECRET=""
# PORTAL_JWT_SECRET=""

# App
NODE_ENV="development"

# Секрет для авторизации ежедневных cron-эндпоинтов (/api/cron/*).
# Тот же самый должен быть прописан в GitHub Secrets как CRON_SECRET —
# воркфлоу .github/workflows/*.yml шлют его в заголовке Authorization.
# Генерация: `openssl rand -hex 32`
CRON_SECRET=""

# T-Bank Business API (выписка для сверки оплат SaaS-счетов + Invoicing)
# Токен из ЛК Т-Бизнеса: https://www.tbank.ru/business/open-api/
# Для крона billing-check-payments токену нужно право «Выписки».
TBANK_API_TOKEN=""
# "true" = sandbox (по умолчанию), "false" = production (обязательно на проде)
TBANK_SANDBOX="true"
# Расчётный счёт, по которому тянется выписка (он же в PDF счёта)
TBANK_ACCOUNT_NUMBER="40802810200005974620"
# Секрет для верификации webhook (произвольная строка)
TBANK_WEBHOOK_SECRET=""

# checko.ru — официальное наименование заказчика (юрлицо/ИП) по ИНН для PDF счёта.
# Ключ из ЛК: https://checko.ru/integration/api . Без ключа в счёте останется
# название организации из системы (organization.name). ИНН 12 знаков → ИП, 10 → ЮЛ.
CHECKO_API_KEY=""

# Реквизиты исполнителя в PDF «Счёт-договор оферты» (дефолты — ИП Шиманский,
# см. src/lib/billing/requisites.ts; переопределять только при смене банка/адреса)
# BILLING_EXECUTOR_NAME=""
# BILLING_EXECUTOR_ADDRESS=""
# BILLING_EXECUTOR_BANK=""
# BILLING_EXECUTOR_BIK=""
# BILLING_EXECUTOR_CORR_ACCOUNT=""
# BILLING_SERVICE_NAME=""

# SMTP — собственный почтовый сервер (docker-mailserver на mail.umnayacrm.ru)
# Если не задано — письма не отправляются, линки восстановления логируются в консоль.
SMTP_HOST="mail.umnayacrm.ru"
SMTP_PORT="465"
SMTP_USER="noreply@umnayacrm.ru"
SMTP_PASS=""
MAIL_FROM="Умная CRM <noreply@umnayacrm.ru>"

# AI-ассистент CRM (/api/ai/chat). Без ключа выбранного провайдера — «временно недоступен».
# Провайдер: "anthropic" (по умолчанию, Claude Haiku 4.5) или "openai" (gpt-5.4-mini).
AI_PROVIDER="anthropic"
# --- Anthropic --- ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""           # пусто = claude-haiku-4-5
ANTHROPIC_BASE_URL=""        # БЕЗ /v1; релей напр. https://<релей>/anthropic
# --- OpenAI --- ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL=""              # пусто = gpt-5.4-mini
OPENAI_BASE_URL=""           # С /v1; релей напр. https://<релей>/v1
