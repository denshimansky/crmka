{
  "manifest_version": 3,
  "name": "CRMka — панель в мессенджерах",
  "short_name": "CRMka",
  "version": "0.1.0",
  "description": "Карточка клиента CRMka рядом с чатом: подопечные, занятия, абонементы, баланс и переписка по всем каналам.",

  "permissions": ["sidePanel", "storage", "tabs", "scripting"],

  "host_permissions": [
    "https://app.umnayacrm.ru/*",
    "https://dev.umnayacrm.ru/*",
    "https://msk1.umnayacrm.ru/*",
    "https://web.telegram.org/*",
    "https://web.max.ru/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "src/panel/panel.html"
  },

  "action": {
    "default_title": "CRMka — панель клиента"
  },

  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": [
        "src/content/adapter-core.js",
        "src/content/telegram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.max.ru/*"],
      "js": [
        "src/content/adapter-core.js",
        "src/content/max.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "src/common/telegram-hash.js",
        "src/common/telegram-time.js",
        "src/common/telegram-peer.js"
      ],
      "matches": ["https://web.telegram.org/*"]
    },
    {
      "resources": [
        "src/common/max-path.js",
        "src/common/max-time.js",
        "src/common/max-message.js",
        "src/common/selector-config.js"
      ],
      "matches": ["https://web.max.ru/*"]
    }
  ]
}
